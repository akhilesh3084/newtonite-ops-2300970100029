generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  MEMBER
  LEAD
}

enum ItemType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum EventKind {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  FIELD_CHANGED
  COMMENTED
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  memberships  Membership[]
  createdItems WorkItem[]   @relation("CreatedBy")
  assignedItems WorkItem[]  @relation("Assignee")
  activity     ActivityEvent[]
  comments     Comment[]
  notifications Notification[]
  idempotencyKeys IdempotencyKey[]
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  workItems   WorkItem[]
}

model Membership {
  userId String @db.Uuid
  teamId String @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
  @@index([teamId, role])
}

model WorkItem {
  id          String     @id @default(uuid()) @db.Uuid
  teamId      String     @db.Uuid
  title       String     @db.VarChar(200)
  description String
  type        ItemType
  priority    Priority   @default(MEDIUM)
  status      Status     @default(OPEN)
  assigneeId  String?    @db.Uuid
  createdById String     @db.Uuid
  dueDate     DateTime?  @db.Date
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  team      Team            @relation(fields: [teamId], references: [id])
  assignee  User?           @relation("Assignee", fields: [assigneeId], references: [id])
  createdBy User            @relation("CreatedBy", fields: [createdById], references: [id])
  activity  ActivityEvent[]
  comments  Comment[]
  notifications Notification[]

  @@index([teamId, status, priority])
  @@index([assigneeId, status])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([dueDate])
  @@index([updatedAt])
}

model ActivityEvent {
  id        String    @id @default(uuid()) @db.Uuid
  itemId    String    @db.Uuid
  actorId   String    @db.Uuid
  kind      EventKind
  field     String?
  fromValue String?
  toValue   String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  item  WorkItem @relation(fields: [itemId], references: [id])
  actor User     @relation(fields: [actorId], references: [id])

  @@index([itemId, createdAt])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  item   WorkItem @relation(fields: [itemId], references: [id])
  author User     @relation(fields: [authorId], references: [id])

  @@index([itemId, createdAt])
}

model IdempotencyKey {
  userId       String   @db.Uuid
  key          String   @db.VarChar(255)
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, key])
}

model OutboxJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now()) @db.Timestamptz(3)
  lockedAt    DateTime? @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, runAfter])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  itemId    String    @db.Uuid
  message   String
  dedupeKey String    @unique
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User     @relation(fields: [userId], references: [id])
  item WorkItem @relation(fields: [itemId], references: [id])

  @@index([userId, createdAt])
}
