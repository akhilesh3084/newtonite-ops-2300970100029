# Demo-only values for local development. Do not use in production.

# Postgres (Compose maps host 5433 → container 5432)
DATABASE_URL=postgresql://ops:ops@localhost:5433/newtonite?schema=public
DATABASE_URL_TEST=postgresql://ops:ops@localhost:5433/newtonite_test?schema=public

# Inside Docker network the API/worker use the service hostname:
# DATABASE_URL=postgresql://ops:ops@postgres:5432/newtonite?schema=public

JWT_SECRET=demo-only-change-me-before-any-real-use
JWT_EXPIRES_IN=8h

DEMO_PASSWORD=Demo@1234

PORT=3000
NODE_ENV=development

# Worker
OUTBOX_POLL_MS=1000
OUTBOX_LOCK_TIMEOUT_SEC=120
OUTBOX_BATCH_SIZE=10
